# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Neon / Supabase connection string) ---
DATABASE_URL=postgresql://user:password@host:5432/serani_spark?sslmode=require

# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# --- Admin auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# --- M-Pesa Daraja (sandbox first, then production) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-deployed-backend.up.railway.app/api/payments/mpesa-callback

# --- WhatsApp support ---
WHATSAPP_BUSINESS_NUMBER=254700000000
